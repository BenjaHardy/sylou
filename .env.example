# Frontend build-time environment (Vite). Copy to `.env` for local development.
#
# These are PUBLISHABLE values — they are baked into the JS bundle at build
# time and are safe to expose. Never put service-role keys or LLM provider
# keys here; those are edge-function secrets (see
# supabase/functions/.env.example and docs/setup.md).

# Your Supabase project URL — Dashboard → Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The publishable ("anon") API key from the same page.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Local stack (`supabase start`): put the API URL and the publishable key that
# `supabase status` prints in a `.env.local` file, which overrides `.env`:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: public site URL used for links in shared reports. If unset, the
# browser's current origin is used — the right default for most deployments.
# Only set it if your public URL differs from the deployed origin (e.g.
# behind a reverse proxy).
# VITE_PUBLIC_SITE_URL=https://yourdomain.example
