# ---------------------------------------------------------------------------
# Sylou instance provenance
# ---------------------------------------------------------------------------
# Stamped onto every FLOW report at generation time via `generator_info`.
# Shared/public reports display these values so viewers know which instance
# produced the report. All four are optional — sensible defaults are used.

# Label shown next to the domain. Use "official" for the maintainer's
# instance (sylou.eu) and "self-hosted" for any other deployment.
# Default: "self-hosted"
SYLOU_INSTANCE_LABEL=self-hosted

# Public domain of this instance, e.g. "sylou.eu" or "writing.acme.edu".
# Default: null  → renders as "(domain not configured)" in shared reports.
SYLOU_INSTANCE_DOMAIN=

# Release version of the Sylou build, e.g. "v1.4.2".
# Default: "unknown"
SYLOU_VERSION=

# First 7 chars of the git commit SHA this build was made from, e.g. "a1b2c3d".
# Viewers can compare it against the official Sylou repository's release
# tags. Like every value in this section, it is declared by the operator:
# viewers cannot verify which code actually produced a report.
# Default: "unknown"
SYLOU_COMMIT_HASH=

# ---------------------------------------------------------------------------
# CORS allow-list
# ---------------------------------------------------------------------------
# Comma-separated list of origins (scheme + host, no path, no trailing slash)
# from which browser clients are allowed to call these edge functions. The
# function echoes back the request's Origin header only if it appears in
# this list; otherwise the Access-Control-Allow-Origin header is omitted and
# the browser blocks the response.
#
# Example:
# ALLOWED_ORIGIN=https://sylou.eu,https://app.example.com
#
# If unset, no cross-origin browser requests will be accepted and a warning
# is logged at function startup. Do NOT set this to "*" in production — it
# would allow any site on the internet to call your backend from a user's
# browser.
ALLOWED_ORIGIN=

# ---------------------------------------------------------------------------
# LLM provider keys
# ---------------------------------------------------------------------------
# Set at least one. A provider whose key is unset still appears in Sylou's
# model picker but fails at runtime if selected — set keys for the providers
# you want your users to actually have access to. New users start on GLM 5.2
# (served through the Mistral API) for both chat and FLOW: without
# MISTRAL_API_KEY, they must pick another model in Settings among the
# recommended ones (see docs/model-configuration.md).
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# Web search (optional)
# ---------------------------------------------------------------------------
# Brave Search API key (https://api.search.brave.com). If unset, the web
# search toggle in Sylou's UI is greyed out with an explanatory tooltip;
# nothing else breaks.
BRAVE_SEARCH_API_KEY=
