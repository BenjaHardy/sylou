{
  "nodeModulesDir": "auto",
  "exclude": ["node_modules"],
  "lint": {
    "rules": {
      // no-import-prefix: inline https:/npm: imports are the standard Supabase
      //   edge-function style (no import map here).
      // (no-inner-declarations was excluded here until the analysis split
      //   lifted the last request-scoped declaration to module scope.)
      "exclude": ["no-import-prefix"]
    }
  },
  "tasks": {
    "check": "deno check **/*.ts",
    "lint": "deno lint",
    // deno test collects only *.test.ts from listed directories. Handler
    // tests import an index.ts through _shared/_test_support.ts, which stubs
    // Deno.serve first; --allow-env=ALLOWED_ORIGIN lets them set the CORS
    // allow-list that _cors.ts reads at module load.
    "test": "deno test --allow-read --allow-env=ALLOWED_ORIGIN _shared/ context-prompt/ analysis/ chat/ share-report/"
  }
}
