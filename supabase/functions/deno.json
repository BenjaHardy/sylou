{
  "nodeModulesDir": "auto",
  "exclude": ["node_modules"],
  "lint": {
    "rules": {
      // no-import-prefix: inline https:/npm: imports are the standard Supabase
      //   edge-function style (no import map here).
      // no-inner-declarations: the streaming handlers intentionally declare
      //   inner functions that close over request-scoped state.
      "exclude": ["no-import-prefix", "no-inner-declarations"]
    }
  },
  "tasks": {
    "check": "deno check **/*.ts",
    "lint": "deno lint"
  }
}
