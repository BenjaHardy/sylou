{
  "nodeModulesDir": "auto",
  "exclude": ["node_modules"],
  "lint": {
    "rules": {
      // no-import-prefix: inline https:/npm: imports are the standard Supabase
      //   edge-function style (no import map here).
      // (no-inner-declarations was excluded here until the analysis split
      //   lifted the last request-scoped declaration to module scope.)
      "exclude": ["no-import-prefix"]
    }
  },
  "tasks": {
    "check": "deno check **/*.ts",
    "lint": "deno lint",
    // deno test collects only *.test.ts from listed directories; the
    // functions' index.ts files are never imported (importing one would
    // execute Deno.serve).
    "test": "deno test --allow-read _shared/ context-prompt/ analysis/"
  }
}
