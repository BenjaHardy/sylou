{
  "exclude": ["config", "node_modules"],
  "tasks": {
    "check": "deno check functions/main.ts tests/*.ts tools/*.ts",
    "lint": "deno lint",
    // The recipe test asks the docker command to resolve compose.yaml (no
    // daemon needed) and writes its stand-in secret files to a temp folder.
    // The script tests run `sylou setup` for real, through cmd.exe on
    // Windows and sh elsewhere, with a fake docker that is a deno script.
    // The tools tests reach a database when DATABASE_URL is set, and skip
    // themselves when it is not.
    "test": "deno test --allow-read --allow-write --allow-run=docker,cmd.exe,sh,deno --allow-env --allow-net tests/ tools/",
    // The Windows runner's share: the commands, as a release is used. It
    // leaves the recipe test out, which wants the docker command.
    "test:scripts": "deno test --allow-read --allow-write --allow-run=docker,cmd.exe,sh,deno --allow-env --allow-net tests/scripts.test.ts",
    // The live checks, against a running install whose settings carry
    // SYLOU_INSTANCE_LABEL=package-test; skipped where there is none. They
    // make accounts, back up, remove and restore: see tests/package.test.ts.
    "test:package": "deno test --allow-read --allow-write --allow-run=docker,sh,ss --allow-env --allow-net --allow-sys=networkInterfaces tests/package.test.ts",
    // The functions image is built from functions/deno.lock (D12), and its
    // build stops when the functions load anything that file does not name.
    // After a change to the functions' imports, this writes it afresh from
    // the eight entrypoints.
    "lock:functions": "rm -f functions/deno.lock && deno cache --config=functions/deno.json --node-modules-dir=none --lock=functions/deno.lock ../supabase/functions/*/index.ts",
    // The packages that lockfile names, as a CycloneDX SBOM on standard
    // output, for the image scanner (D27).
    "sbom:functions": "deno run --allow-read=functions/deno.lock tools/functions-sbom.ts functions/deno.lock"
  },
  "lint": {
    "rules": {
      // Inline https: imports are the style the edge functions use; the
      // tools share it so the two stacks read alike.
      "exclude": ["no-import-prefix"]
    }
  }
}
