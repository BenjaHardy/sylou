# Sylou Local — settings.
#
# `sylou setup` copies this file to config/settings.env. Edit that copy, not
# this one, and run `sylou start` again for a change to take effect.
#
# Nothing secret belongs in this file. Keys live in config/secrets/, one file
# each, readable by your account only — see the last section.

# The address Sylou answers on, on this computer only: http://localhost:8080
# Change it if something else already uses 8080 (the developer stack does, and
# the two are never meant to run at the same time). `sylou setup` checks that
# the port is free.
SYLOU_PORT=8080

# Which build of Sylou's own three images to run. `dev` means the images you
# built yourself with `docker compose build`; a release sets this to its
# version, and the images are then downloaded ready-made.
SYLOU_IMAGE_TAG=dev

# What this install calls itself in the app's own logs. Any short word.
SYLOU_INSTANCE_LABEL=local

# Local-only mode: this computer and nothing else. Leave it empty here —
# `sylou local-only on` sets it, because the mode also changes which networks
# the functions are on. With it on, the cloud providers and web search are
# refused with one sentence, and only models on this computer answer.
SYLOU_LOCAL_ONLY=

# ---------------------------------------------------------------------------
# Models on this computer (Ollama)
# ---------------------------------------------------------------------------
#
# Leave both empty to use cloud models only.
#
# Ollama runs on the computer, not in Docker. On Windows and macOS, Docker
# Desktop reaches it at the address below. On Linux, models on this computer
# are not part of this release (the engine has no such route without opening
# Ollama to more than itself).
#
# A tip worth taking: set OLLAMA_NO_CLOUD=1 in Ollama's own settings, so a
# model name you mistype is never answered by Ollama's cloud.
OLLAMA_URL=
# The models Sylou may offer, by name, separated by commas. They must already
# be pulled (`ollama list` shows them), and their context window decides how
# much of a document Sylou can send at once.
OLLAMA_MODELS=

# ---------------------------------------------------------------------------
# Your API keys — not here
# ---------------------------------------------------------------------------
#
# Keys are files, never settings: a setting would show up in Docker's own
# record of the container, and in anything that reads it. `sylou setup`
# creates one empty file per provider in config/secrets/:
#
#   anthropic_api_key      Claude models
#   mistral_api_key        Mistral and Z.ai models
#   deepseek_api_key       DeepSeek models
#   brave_search_api_key   web search in the chat
#
# Paste a key into the file it belongs to (no quotes, no spaces, no newline
# needed) and run `sylou start` again. An empty file means "not configured",
# and Sylou says so where that provider would have been used.
